# PostgreSQL connection used by the Spring Boot backend
DB_URL=jdbc:postgresql://localhost:5432/wafa_gestion
DB_USERNAME=wafa_gestion
DB_PASSWORD=change-me

# Base64-encoded secret of at least 32 random bytes. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-encoded-random-secret
# ISO-8601 duration (default: 8 hours)
JWT_EXPIRATION=PT8H

# Comma-separated frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional runtime settings
SERVER_PORT=8080
SWAGGER_ENABLED=true

# Optional local demo seed. It only runs when both values are enabled.
SPRING_PROFILES_ACTIVE=dev
DEMO_DATA_ENABLED=false
